<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Unstable builds install next to the stable app (applicationIdSuffix ".unstable"), so they get
         their own name to tell the two apart in the launcher and the keyboard picker. -->

    <!-- Application name for the keyboard. -->
    <string name="english_ime_name" translatable="false">Pluto Unstable</string>

    <!-- Name of Android spell checker service. -->
    <string name="spell_checker_service_name" translatable="false">Pluto Unstable Spell Checker</string>

    <!-- Title for Android Keyboard settings screen. -->
    <string name="english_ime_settings" translatable="false">Pluto Unstable Settings</string>

    <!-- Title for the spell checking service settings screen. -->
    <string name="android_spell_checker_settings" translatable="false">Pluto Unstable Spell Checker Settings</string>
</resources>
